# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tradadda?schema=public"

# Server
PORT=8000
NODE_ENV=development

# JWT Secret (for future auth)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Upstox API
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback
CLIENT_URL=http://localhost:3000

# Admin Secret (protects the /api/upstox/admin-login route)
ADMIN_SECRET=your-strong-admin-secret-here

# Optional: pre-set access token (overrides database-stored token)
UPSTOX_ACCESS_TOKEN=
